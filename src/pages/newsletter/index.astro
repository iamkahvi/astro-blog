---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";
import NewsletterLogo from "../../components/NewsletterLogo.astro";
import NewsletterList from "../../components/NewsletterList";
import { getSearchFromParams, stripMarkdown } from "../../lib/search";
import "../../styles/newsletter-archive.css";

const title = "newsletter";
const description = "an archive of my monthly email newsletter";

const allIssues = await getCollection("newsletter");
const sortedIssues = allIssues
  .filter((issue) => issue.data.published ?? true)
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  );
const initialSearch = getSearchFromParams(Astro.url.searchParams);

// `NewsletterList` hydrates on the client. Do not serialize the raw Markdown
// body into its props: embedded HTML is interpreted by Firefox's speculative
// loader, which mistakenly requests iframe URLs from this site's origin.
const searchableIssues = sortedIssues.map(({ id, data, body }) => ({
  id,
  data,
  body: stripMarkdown(body),
}));
---

<Layout title={title} description={description}>
  <NewsletterLogo short clickable={false} />
  <p class="f6 roboto c-second mb4">
    an archive of my monthly email newsletter -{" "}
    <a href="https://www.newsletter.kahvipatel.com" target="_blank" rel="noopener">
      subscribe here
    </a>
  </p>
  <NewsletterList
    issues={searchableIssues}
    initialSearch={initialSearch}
    client:load
  />
</Layout>
