---
const title = "kahvi's newsletter";
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Rubik:wght@900&display=swap"
  rel="stylesheet"
/>
<style>
  body {
    background: white;
    margin: 40px;
  }

  @keyframes gradient-shift {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .newsletter-title {
    --c-shadow: #b96de0;

    display: flex;
    flex-direction: column;
    font-family: "Rubik", "Arial Black", "Helvetica Neue", sans-serif;
    font-weight: 900;
    font-size: 7rem;
    line-height: 0.85;
    color: var(--c-main);
    transition:
      color 0.3s ease,
      text-shadow 0.3s ease,
      font-size 0.2s ease;
    text-shadow:
      -8px 8px 0 color-mix(in srgb, var(--c-shadow) 55%, var(--c-main)),
      -16px 16px 0 color-mix(in srgb, var(--c-shadow) 66%, var(--c-main)),
      -24px 24px 0 var(--c-shadow);
  }

  .newsletter-title-wrapper:hover .newsletter-title {
    -webkit-text-fill-color: white; /* Will override color (regardless of order) */
    -webkit-text-stroke-width: 1px;
    -webkit-text-stroke-color: black;
    font-size: 7.5rem;
    text-shadow:
      -8px 8px 0 color-mix(in srgb, var(--c-main) 55%, var(--c-shadow)),
      -16px 16px 0 color-mix(in srgb, var(--c-main) 66%, var(--c-shadow)),
      -24px 24px 0 var(--c-main);
  }

  .newsletter-title-wrapper {
    /* border: 1px solid red; */
    padding: 0 0 24px 24px;
    margin-bottom: 24px;
  }

  a.newsletter-link {
    color: inherit;
    &::after {
      content: none;
    }
    &:hover {
      color: inherit;
    }
  }
</style>

<div class="newsletter-title-wrapper">
  <a
    class="newsletter-link"
    href="https://www.newsletter.kahvipatel.com/"
    target="_blank"
  >
    <span class="newsletter-title">read the</span>
    <span class="newsletter-title">newsletter</span>
  </a>
</div>
