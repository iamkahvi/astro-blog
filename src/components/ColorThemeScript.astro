---
import { themeMap } from "./colorThemes";
---

<!-- This must stay inline and blocking so the theme is set before first paint. -->
<script is:inline define:vars={{ themeMap }}>
  (() => {
    let storedTheme = null;

    try {
      storedTheme = window.localStorage.getItem("color-theme");
    } catch {
      // localStorage can be unavailable in privacy-restricted contexts.
    }

    const theme = Object.prototype.hasOwnProperty.call(themeMap, storedTheme)
      ? storedTheme
      : window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "classic";

    for (const [property, value] of Object.entries(themeMap[theme])) {
      document.documentElement.style.setProperty(property, value);

      if (property === "--c-main") {
        document.documentElement.style.setProperty(
          "--c-main-selection",
          `${value}50`,
        );
      }
    }
  })();
</script>

<script>
  import { setTheme } from "../lib/color-theme.ts";

  const button = document.getElementById("color-theme-toggle");
  button?.addEventListener("click", () => setTheme());
</script>
